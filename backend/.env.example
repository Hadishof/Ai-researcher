# Copy this file to .env (in the backend/ folder) and fill in your key.
# Required:
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: every other setting, shown with its default value.
# Remove the "# " in front of a line to change it.

# Gemini models
# EMBEDDING_MODEL=gemini-embedding-001
# GENERATION_MODEL=gemini-2.5-flash

# Where data is stored (paths can be absolute or relative to where the backend runs)
# CHROMA_PATH=  (default: the backend/chroma_db/ folder; the vector database)
# COLLECTION_NAME=documents
# DATABASE_PATH=  (default: the file conversations.db in the backend/data/ folder)
# FILES_PATH=  (default: the backend/data/files/ folder, for the uploaded PDFs)

# Follow-up questions: how many earlier messages are used to rewrite them (0 = off)
# HISTORY_MESSAGES=6

# Chunking, in characters
# CHUNK_SIZE=500
# CHUNK_OVERLAP=75

# Retrieval (tuned on the evaluation's dev set; see backend/app/core/config.py)
# TOP_K=5
# MAX_DISTANCE=0.34
# RELATIVE_MARGIN=0.10

# Uploads, CORS and logging
# MAX_UPLOAD_MB=20
# FRONTEND_ORIGIN=http://localhost:5173
# LOG_LEVEL=INFO
